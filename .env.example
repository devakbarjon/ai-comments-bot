# Telegram Bot Configuration
TOKEN=your_telegram_bot_token_here
ADMINS=your_telegram_user_id_here

# Telegram Userbot (for session management)
API_ID=your_telegram_api_id_here
API_HASH=your_telegram_api_hash_here

# Database Configuration (PostgreSQL)
DNS=postgresql+asyncpg://user:password@host/database_name

# AI Configuration (OpenAI/OpenRouter)
AI_API_KEY=your_ai_api_key_here
AI_API_BASE=https://openrouter.ai/api/v1  # Set to empty string for direct OpenAI
AI_MODEL=openrouter/free  # Example model; adjust as needed

# Optional Gemini fallback used when the primary AI provider returns HTTP 429
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash